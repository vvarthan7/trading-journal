# Copy to backend/.env and fill in. This file is the template; .env is gitignored.
#
# These are the values that used to sit in ../.env.local as VITE_SMARTAPI_*. Move them here and
# DELETE them from ../.env.local — anything named VITE_* is compiled into the browser bundle and
# is readable by anyone who opens the deployed site.

SMARTAPI_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_MPIN=
# The base32 seed from TOTP setup, not the rotating 6-digit code.
SMARTAPI_TOTP_SECRET=

# Used to verify the caller's Supabase session. Same values as the frontend uses.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional: restrict to a single Supabase user id. Find it in Authentication > Users.
ALLOWED_USER_ID=

# Browser origins allowed to call this service, comma separated.
ALLOWED_ORIGINS=
